# ── Server ──────────────────────────────────────────
# Port the Express server listens on
PORT=5000

# MongoDB connection string (local instance)
MONGO_URI=mongodb://localhost:27017/skytrip

# ── Auth ─────────────────────────────────────────────
# Secret key for signing JWT tokens — CHANGE THIS to a long random string in production
JWT_SECRET=your_super_secret_jwt_key_change_this_before_use
